<?xml version="1.0" encoding="utf-8"?>
<!--
    Regras do Auto Backup para Android 11 (API 30) ou anterior.
    O Android 12+ usa data_extraction_rules.xml; mantenha os dois iguais.

    O que vai para a conta Google da professora:
    - o banco do diário (turmas, alunos, chamadas, pendências, anotações);
    - as preferências do DataStore (ex.: turma ativa).

    As fotos (files/fotos) ficam de fora: o Auto Backup tem limite de 25 MB por
    app, e poucas dezenas de fotos já passariam disso. Elas vão na exportação (.zip).
-->
<full-backup-content>
    <include domain="database" path="diario.db" />
    <include domain="file" path="datastore/" />
</full-backup-content>

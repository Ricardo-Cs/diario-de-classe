<?xml version="1.0" encoding="utf-8"?>
<!--
    Regras de backup para Android 12 (API 31) ou superior.
    Mantenha igual a backup_rules.xml (usado nas versões anteriores).

    - cloud-backup: cópia automática na conta Google (Auto Backup).
    - device-transfer: cópia direta ao configurar um celular novo a partir do antigo.
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="diario.db" />
        <include domain="file" path="datastore/" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="diario.db" />
        <include domain="file" path="datastore/" />
    </device-transfer>
</data-extraction-rules>
